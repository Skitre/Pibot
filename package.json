{
  "name": "pibot",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first multi-bot AI workspace with host-side pi-sdk agents and one shared Docker desktop",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "image": "docker build -t pibot-computer:latest bot-image"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "protobufjs@7.6.5": true
  }
}
