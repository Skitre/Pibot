#!/usr/bin/with-contenv bash
# 共享 Chromium 由 s6 守护，避免 XFCE autostart 在容器首次启动时因时序丢失。
export HOME=/config
export DISPLAY=:1

# 等 Xvfb 真正可用；s6 会在 Chromium 异常退出后重新执行本脚本。
while [ ! -S /tmp/.X11-unix/X1 ]; do
  sleep 1
done

PROFILE=/config/.config/chromium
mkdir -p "$PROFILE"
# 容器重建会更换 hostname，Chromium 留下的 Singleton* 锁会被误判为其他机器占用。
rm -f "$PROFILE"/SingletonCookie "$PROFILE"/SingletonLock "$PROFILE"/SingletonSocket
chown -R abc:abc "$PROFILE"

exec s6-setuidgid abc chromium \
  --user-data-dir="$PROFILE" \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  --no-first-run \
  --disable-dev-shm-usage \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --start-maximized
